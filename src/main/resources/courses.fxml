<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750" prefWidth="1100" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="schoolmanagement.smproject.courses.controller.CoursesController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="25" styleClass="sidebar">
            <VBox alignment="CENTER" spacing="12" styleClass="logo-section">
                <Label styleClass="logo-icon" text="🎓" />
                <Label styleClass="logo-title" text="School MS" />
                <Label fx:id="userRoleLabel" styleClass="user-badge" text="ADMIN" />
            </VBox>
            <Separator styleClass="sidebar-separator" />
            <VBox spacing="6">
                <Label alignment="CENTER" prefHeight="58.0" prefWidth="266.0" style="-fx-font-family: Segoe UI; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 17;" styleClass="menu-label" text="MENU" />
                <Button fx:id="btnDashboard" onAction="#handleDashboard" style="-fx-text-fill: white;" styleClass="nav-button" text="📊 Dashboard" />
                <Button fx:id="btnStudents" onAction="#handleStudents" style="-fx-text-fill: white;" styleClass="nav-button" text="👨‍🎓 Students" />
                <Button fx:id="btnTeachers" onAction="#handleTeachers" style="-fx-text-fill: white;" styleClass="nav-button" text="👨‍🏫 Teachers" />
                <Button fx:id="btnCourses" onAction="#handleCourses" style="-fx-background-color: #2F4C7A; -fx-text-fill: white; -fx-font-weight: bold;" styleClass="nav-button" text="📚 Courses" />
                <Button fx:id="btnGrades" onAction="#handleGrades" style="-fx-text-fill: white;" styleClass="nav-button" text="📝 Grades" />
            <Button onAction="#handleReport" style="-fx-text-fill: white;" styleClass="nav-button" text="📊 Reports" />
            </VBox>
            <VBox VBox.vgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-font-weight: bold;" styleClass="logout-button" text="🚪  Logout" />
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="24" styleClass="main-container">
            
            <!-- Header & Actions -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox>
                    <Label styleClass="page-title" text="📚 All Courses" />
                    <Label styleClass="page-subtitle" text="Manage academic courses and assignments" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleExportExcel" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" styleClass="btn-outline" text="📊 Excel" />
            <Button onAction="#handleExportPDF" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" styleClass="btn-primary" text="📄 PDF" />
                <Button onAction="#handleAddCourse" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" styleClass="btn-primary" text="➕ Add New Course" />
            </HBox>

            <!-- Search & Filter Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-section">
                <TextField fx:id="txtSearch" promptText="🔍 Search by code, name, or teacher..." style="-fx-padding: 8; -fx-background-radius: 8;" styleClass="form-input" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="cbLevelFilter" prefWidth="120" promptText="All Levels" styleClass="form-input" />
                <ComboBox fx:id="cbStatusFilter" prefWidth="130" promptText="All Status" styleClass="form-input" />
                <Button onAction="#handleSearch" style="-fx-background-color: #263F6B; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold; -fx-text-fill: white;" styleClass="btn-primary" text="Search" />
                <Button onAction="#handleClearFilters" style="-fx-background-color: #263F6B; -fx-background-radius: 8; -fx-padding: 8 16; -fx-text-fill: white; -fx-font-weight: bold;" styleClass="btn-outline" text="Clear" />
            </HBox>

            <!-- Courses Table -->
            <VBox styleClass="form-section" VBox.vgrow="ALWAYS">
                <TableView fx:id="coursesTable" styleClass="custom-table">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                        <TableColumn fx:id="colCode" prefWidth="120" text="Code" />
                        <TableColumn fx:id="colName" prefWidth="200" text="Course Name" />
                        <TableColumn fx:id="colLevel" prefWidth="100" text="Level" />
                        <TableColumn fx:id="colTeacher" prefWidth="180" text="Teacher" />
                        <TableColumn fx:id="colHours" minWidth="80.0" prefWidth="80" text="Hours" />
                        <TableColumn fx:id="colCapacity" prefWidth="100" text="Capacity" />
                        <TableColumn fx:id="colStatus" prefWidth="110" text="Status" />
                        <TableColumn fx:id="colActions" prefWidth="120" text="Actions" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Pagination Info -->
            <HBox alignment="CENTER" spacing="12">
                <Label fx:id="lblCourseCount" styleClass="page-subtitle" text="Showing 0 courses" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnPrevious" onAction="#handlePrevious" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8;" styleClass="btn-outline" text="⬅ Previous" />
                <Label fx:id="lblPageInfo" style="-fx-font-weight: bold;" text="Page 1 of 1" />
                <Button fx:id="btnNext" onAction="#handleNext" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8;" styleClass="btn-outline" text="Next ➡" />
            </HBox>

        </VBox>
    </center>
</BorderPane>
