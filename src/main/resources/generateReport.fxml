<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="18" stylesheets="@dashboard.css, @reports.css"
    xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="schoolmanagement.smproject.reports.controller.GenerateReportController"
    styleClass="modal-background">

    <padding>
        <Insets bottom="25" left="30" right="30" top="25" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Label styleClass="modal-title" text="📝 Generate Report" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" styleClass="btn-close" text="✕" />
    </HBox>
    <Separator />

    <VBox spacing="6">
        <Label styleClass="label" text="Report Title:" />
        <TextField fx:id="txtReportName" promptText="e.g., Monthly Enrollment Report - May 2026"
            styleClass="text-field" />
    </VBox>

    <HBox spacing="15">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label styleClass="label" text="Report Type:" />
            <ComboBox fx:id="cbReportType" promptText="Select report type" styleClass="combo-box"
                maxWidth="Infinity" />
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label styleClass="label" text="Report Date:" />
            <DatePicker fx:id="dpReportDate" styleClass="date-picker" maxWidth="Infinity" />
        </VBox>
    </HBox>

    <VBox spacing="6" VBox.vgrow="ALWAYS">
        <Label styleClass="label" text="Report Content:" />
        <TextArea fx:id="txtReportContent" prefHeight="250"
            promptText="Enter the report content here..." styleClass="text-area" wrapText="true" />
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="btn-cancel" />
        <Button text="Generate Report" onAction="#handleGenerate" styleClass="btn-primary"
            fx:id="btnGenerate" />
    </HBox>
</VBox>