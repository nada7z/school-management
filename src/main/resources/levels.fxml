<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750" prefWidth="1100" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="schoolmanagement.smproject.levels.controller.LevelsController">
    <left>
        <VBox spacing="25" styleClass="sidebar">
            <VBox alignment="CENTER" spacing="12" styleClass="logo-section">
                <Label styleClass="logo-icon" text="🎓" />
                <Label styleClass="logo-title" text="School MS" />
                <Label fx:id="userRoleLabel" styleClass="user-badge" text="ADMIN" />
            </VBox>
            <Separator styleClass="sidebar-separator" />
            <VBox spacing="6">
                <Label alignment="CENTER" prefHeight="58.0" prefWidth="266.0" style="-fx-font-family: Segoe UI; -fx-text-fill: #EAF1FB; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 20;" styleClass="menu-label" text="MENU" />
                <Button fx:id="btnDashboard" onAction="#handleDashboard" styleClass="nav-button" text="📊 Dashboard" />
                <Button fx:id="btnStudents" onAction="#handleStudents" styleClass="nav-button" text="👨‍🎓 Students" />
                <Button fx:id="btnTeachers" onAction="#handleTeachers" styleClass="nav-button" text="👨‍🏫 Teachers" />
                <Button fx:id="btnCourses" onAction="#handleCourses" styleClass="nav-button" text="📚 Courses" />
                <Button fx:id="btnGrades" onAction="#handleGrades" style="-fx-background-color: #2F4C7A; -fx-text-fill: white; -fx-font-weight: bold;" styleClass="nav-button" text="📝 Grades" />
            <Button onAction="#handleReport" style="-fx-text-fill: white;" styleClass="nav-button" text="📊 Reports" />
            </VBox>
            <VBox VBox.vgrow="ALWAYS" />
            <Button onAction="#handleLogout" styleClass="logout-button" text="🚪 Logout" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" prefHeight="774.0" prefWidth="905.0" styleClass="main-scroll">
            <VBox spacing="30" styleClass="main-container">
                <VBox spacing="8">
                    <Label alignment="CENTER" styleClass="page-title" text="🏫 Academic Levels" />
                    <Label styleClass="page-subtitle" text="Select a level to view its classrooms and students" />
                </VBox>
                <GridPane fx:id="levelsGrid" hgap="22" styleClass="levels-grid" vgap="22" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
