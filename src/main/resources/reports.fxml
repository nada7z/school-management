<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750" prefWidth="1100" stylesheets="@dashboard.css, @reports.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="schoolmanagement.smproject.reports.controller.ReportsController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="25" styleClass="sidebar">
            <VBox alignment="CENTER" spacing="12" styleClass="logo-section">
                <Label styleClass="logo-icon" text="🎓" />
                <Label styleClass="logo-title" text="School MS" />
                <Label fx:id="userRoleLabel" styleClass="user-badge" text="ADMIN" />
            </VBox>
            <Separator styleClass="sidebar-separator" />
            <VBox spacing="6">
                <Label alignment="CENTER" prefHeight="58.0" prefWidth="266.0" style="-fx-font-family: Segoe UI; -fx-text-fill: #EAF1FB; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 20;" styleClass="menu-label" text="MENU" />
                <Button fx:id="btnDashboard" onAction="#handleDashboard" style="-fx-text-fill: white;" styleClass="nav-button" text="📊 Dashboard" />
                <Button fx:id="btnStudents" onAction="#handleStudents" style="-fx-text-fill: white;" styleClass="nav-button" text="👨‍🎓 Students" />
                <Button fx:id="btnTeachers" onAction="#handleTeachers" style="-fx-text-fill: white;" styleClass="nav-button" text="👨‍🏫 Teachers" />
                <Button fx:id="btnCourses" onAction="#handleCourses" style="-fx-text-fill: white;" styleClass="nav-button" text="📚 Courses" />
                <Button fx:id="btnGrades" onAction="#handleGrades" style="-fx-text-fill: white;" styleClass="nav-button" text="📝 Grades" />
                <!-- Highlighted Reports Button -->
                <Button fx:id="btnReports" onAction="#handleReports" style="-fx-background-color: #2F4C7A; -fx-text-fill: white; -fx-font-weight: bold;" styleClass="nav-button" text="📊 Reports" />
            </VBox>
            <VBox VBox.vgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-font-weight: bold;" styleClass="logout-button" text="🚪  Logout" />
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <VBox spacing="24" styleClass="main-container">

                <!-- Header & Actions -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox>
                        <Label style="-fx-font-size: 30; -fx-font-weight: bold;" styleClass="page-title" text="📊 Reports Center" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleExportPDF" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" text="📄 PDF" />
                    <Button onAction="#handleExportExcel" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" text="📊 Excel" />
                    <Button onAction="#handleGenerateReport" style="-fx-background-color: #3fa37a; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" text="➕ Generate Report" />
                </HBox>

                <!-- Stats Cards -->
                <HBox alignment="CENTER" spacing="22" styleClass="stats-grid">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER" spacing="18" style="-fx-background-color: white; -fx-background-radius: 15;">
                            <Label alignment="CENTER" prefHeight="40.0" prefWidth="40.0" style="-fx-font-size: 20; -fx-text-fill: #4a7bc2; -fx-background-color: #e7eff9; -fx-background-radius: 15;" text="📊" />
                            <VBox>
                                <Label fx:id="lblTotalReports" styleClass="stat-value" text="0" />
                                <Label styleClass="stat-label" text="Total Reports" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER" spacing="18" style="-fx-background-color: white; -fx-background-radius: 15;">
                            <Label alignment="CENTER" prefHeight="40.0" prefWidth="40.0" style="-fx-font-size: 20; -fx-text-fill: #3fa37a; -fx-background-color: #e6f4ee; -fx-background-radius: 15;" text="✅" />
                            <VBox>
                                <Label fx:id="lblFinalized" styleClass="stat-value" text="0" />
                                <Label styleClass="stat-label" text="Finalized" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER" spacing="18" style="-fx-background-color: white; -fx-background-radius: 15;">
                            <Label alignment="CENTER" prefHeight="40.0" prefWidth="40.0" style="-fx-font-size: 20; -fx-text-fill: #d39b3c; -fx-background-color: #f9f1e3; -fx-background-radius: 15;" text="⏳" />
                            <VBox>
                                <Label fx:id="lblDrafts" styleClass="stat-value" text="0" />
                                <Label styleClass="stat-label" text="Drafts" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER" spacing="18" style="-fx-background-color: white; -fx-background-radius: 15;">
                            <Label alignment="CENTER" prefHeight="40.0" prefWidth="40.0" style="-fx-font-size: 20; -fx-text-fill: #8b6fd6; -fx-background-color: #efe9fb; -fx-background-radius: 15;" text="📅" />
                            <VBox>
                                <Label fx:id="lblThisMonth" styleClass="stat-value" text="0" />
                                <Label styleClass="stat-label" text="Generated This Month" />
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Quick Actions Panel -->
                <VBox spacing="16" styleClass="form-section">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4a7bc2;" text="Quick Report Generation" />
                    <HBox alignment="CENTER" spacing="18">
                        <Button onAction="#handleGenerateEnrollmentReport" styleClass="quick-action-btn" text="📈 Enrollment Report" />
                        <Button onAction="#handleGenerateAttendanceReport" styleClass="quick-action-btn" text="📅 Attendance Report" />
                        <Button onAction="#handleGenerateParentReport" styleClass="quick-action-btn" text="👨‍👩‍👧 Parent Directory" />
                        <Button onAction="#handleGenerateGradeReport" styleClass="quick-action-btn" text="📝 Grade Distribution" />
                    </HBox>
                </VBox>

                <!-- Filters -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-section">
                    <ComboBox fx:id="cbReportType" prefWidth="180" promptText="All Types" styleClass="combo-box" />
                    <ComboBox fx:id="cbAcademicYear" prefWidth="150" promptText="All Years" styleClass="combo-box" />
                    <TextField fx:id="txtSearch" promptText="🔍 Search reports by name..." style="-fx-padding: 8; -fx-background-radius: 8;" styleClass="text-field" HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleSearch" style="-fx-background-color: #263F6B; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold; -fx-text-fill: white;" text="Search" />
                    <Button onAction="#handleClearFilters" style="-fx-background-color: #263F6B; -fx-background-radius: 8; -fx-padding: 8 16; -fx-text-fill: white; -fx-font-weight: bold;" text="Clear" />
                </HBox>

                <!-- Reports Table -->
                <VBox styleClass="form-section" VBox.vgrow="ALWAYS">
                    <TableView fx:id="reportsTable" styleClass="custom-table">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                            <TableColumn fx:id="colReportType" prefWidth="120" text="Type" />
                            <TableColumn fx:id="colReportName" prefWidth="300" text="Report Name" />
                            <TableColumn fx:id="colAcademicYear" prefWidth="120" text="Academic Year" />
                            <TableColumn fx:id="colGeneratedDate" prefWidth="120" text="Generated Date" />
                            <TableColumn fx:id="colStatus" prefWidth="100" text="Status" />
                            <TableColumn fx:id="colActions" prefWidth="160" text="Actions" />
                        </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Footer Info -->
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblReportCount" styleClass="page-subtitle" text="Showing 0 reports" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
