<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750" prefWidth="1100" stylesheets="@reports.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="schoolmanagement.smproject.reports.controller.ReportsController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="25" styleClass="sidebar">
            <VBox alignment="CENTER" spacing="12" styleClass="logo-section">
                <Label styleClass="logo-icon" text="🎓" />
                <Label styleClass="logo-title" text="School MS" />
                <Label fx:id="userRoleLabel" styleClass="user-badge" text="ADMIN" />
            </VBox>
            <Separator styleClass="sidebar-separator" />
            <VBox spacing="6">
                <Label alignment="CENTER" prefHeight="58.0" prefWidth="266.0" style="-fx-font-family: Segoe UI; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 17;" styleClass="menu-label" text="MENU" />
                <Button fx:id="btnDashboard" onAction="#handleDashboard" style="-fx-text-fill: white;" styleClass="nav-button" text="📊 Dashboard" />
                <Button fx:id="btnStudents" onAction="#handleStudents" style="-fx-text-fill: white;" styleClass="nav-button" text="👨‍🎓 Students" />
                <Button fx:id="btnTeachers" onAction="#handleTeachers" style="-fx-text-fill: white;" styleClass="nav-button" text="👨‍🏫 Teachers" />
                <Button fx:id="btnCourses" onAction="#handleCourses" style="-fx-text-fill: white;" styleClass="nav-button" text="📚 Courses" />
                <Button onAction="#handleGrades" style="-fx-text-fill: white;" styleClass="nav-button" text="📝 Grades" />
                <Button style="-fx-background-color: #2F4C7A; -fx-text-fill: white; -fx-font-weight: bold;" styleClass="nav-button" text="📊 Reports" />
            </VBox>
            <VBox VBox.vgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-font-weight: bold;" styleClass="logout-button" text="🚪  Logout" />
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="24" styleClass="main-container">

            <!-- Header & Actions -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox>
                    <Label styleClass="page-title" text="📊 Reports Center" />
                    <Label styleClass="page-subtitle" text="Generate and manage school reports" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleExportPDF" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" styleClass="btn-primary" text="📄 PDF" />
                <Button onAction="#handleExportExcel" prefHeight="7.0" prefWidth="86.0" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" styleClass="btn-outline" text="📊 Excel" />
                <Button onAction="#handleGenerateReport" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" styleClass="btn-primary" text="➕ Generate Report" />
            </HBox>

            <!-- Quick Actions Panel -->
            <VBox spacing="16" styleClass="form-section">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2F4C7A;" text="Quick Report Generation" />
                <HBox spacing="12">
                    <Button onAction="#handleGenerateEnrollmentReport" styleClass="quick-action-btn" text="📈 Enrollment Report" />
                    <Button onAction="#handleGenerateAttendanceReport" styleClass="quick-action-btn" text="📅 Attendance Report" />
                    <Button onAction="#handleGenerateParentReport" styleClass="quick-action-btn" text="👨‍👩‍👧 Parent Directory" />
                    <Button onAction="#handleGenerateGradeReport" styleClass="quick-action-btn" text="📝 Grade Distribution" />
                </HBox>
            </VBox>

            <!-- Filters -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-section">
                <ComboBox fx:id="cbReportType" prefWidth="180" promptText="Report Type" styleClass="form-input" />
                <ComboBox fx:id="cbAcademicYear" prefHeight="30.0" prefWidth="150" promptText="Academic Year" styleClass="form-input" />
                <TextField fx:id="txtSearch" promptText="🔍 Search reports..." style="-fx-padding: 8; -fx-background-radius: 8;" styleClass="form-input" HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Reports Table -->
            <VBox styleClass="form-section" VBox.vgrow="ALWAYS">
                <TableView fx:id="reportsTable" styleClass="custom-table">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                        <TableColumn fx:id="colReportType" prefWidth="120" text="Type" />
                        <TableColumn fx:id="colReportName" prefWidth="300" text="Report Name" />
                        <TableColumn fx:id="colAcademicYear" prefWidth="120" text="Academic Year" />
                        <TableColumn fx:id="colGeneratedDate" prefWidth="120" text="Generated Date" />
                        <TableColumn fx:id="colStatus" prefWidth="100" text="Status" />
                        <TableColumn fx:id="colActions" prefWidth="120" text="Actions" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Footer Info -->
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblReportCount" styleClass="page-subtitle" text="Showing 0 reports" />
            </HBox>

        </VBox>
    </center>
</BorderPane>
