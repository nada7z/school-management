<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1100" prefHeight="750" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="schoolmanagement.smproject.students.controller.ClassStudentsController">
    <left>
        <VBox spacing="25" styleClass="sidebar">
            <VBox alignment="CENTER" spacing="12" styleClass="logo-section">
                <Label styleClass="logo-icon" text="🎓" />
                <Label styleClass="logo-title" text="School MS" />
                <Label fx:id="userRoleLabel" styleClass="user-badge" text="ADMIN" />
            </VBox>
            <Separator styleClass="sidebar-separator" />
            <VBox spacing="6">
                <Label alignment="CENTER" prefHeight="58.0" prefWidth="266.0" style="-fx-font-family: Segoe UI; -fx-text-fill: #EAF1FB; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-color: #2F4C7A; -fx-background-radius: 20;" styleClass="menu-label" text="MENU" />
                <Button fx:id="btnDashboard" onAction="#handleDashboard" styleClass="nav-button" text="📊 Dashboard" />
                <Button fx:id="btnStudents" onAction="#handleStudents" styleClass="nav-button active" text="👨‍🎓 Students" />
                <Button fx:id="btnLevels" onAction="#handleLevels" styleClass="nav-button" text="🏫 Levels" />
                <Button fx:id="btnGrades" onAction="#handleGrades" styleClass="nav-button" text="📝 Grades" />
            </VBox>
            <VBox VBox.vgrow="ALWAYS" />
            <Button onAction="#handleLogout" styleClass="logout-button" text="🚪 Logout" />
        </VBox>
    </left>

    <center>
        <VBox spacing="24" styleClass="main-container">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Button fx:id="btnBack" onAction="#handleBack" styleClass="btn-outline" text="⬅ Back to Classes" />
                <VBox>
                    <Label fx:id="classTitle" styleClass="page-title" />
                    <Label styleClass="page-subtitle" text="Enrolled students in this classroom" />
                </VBox>
            </HBox>
            <VBox styleClass="form-section" VBox.vgrow="ALWAYS">
                <TableView fx:id="studentsTable" styleClass="custom-table">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="220" text="Full Name" />
                        <TableColumn fx:id="colEmail" prefWidth="240" text="Email" />
                        <TableColumn fx:id="colPhone" prefWidth="160" text="Phone" />
                        <TableColumn fx:id="colParent" prefWidth="200" text="Primary Parent" />
                        <TableColumn fx:id="colStatus" prefWidth="130" text="Status" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>