<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750" prefWidth="1100" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="schoolmanagement.smproject.teachers.controller.TeachersController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="25" styleClass="sidebar">
            <VBox alignment="CENTER" spacing="12" styleClass="logo-section">
                <Label styleClass="logo-icon" text="🎓" />
                <Label styleClass="logo-title" text="School MS" />
                <Label fx:id="userRoleLabel" styleClass="user-badge" text="ADMIN" />
            </VBox>
            <Separator styleClass="sidebar-separator" />
            <VBox spacing="6">
                <Label alignment="CENTER" prefHeight="58.0" prefWidth="266.0" style="-fx-font-family: Segoe UI; -fx-text-fill: #EAF1FB; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 20;" styleClass="menu-label" text="MENU" />
                <Button fx:id="btnDashboard" onAction="#handleDashboard" style="-fx-text-fill: white;" styleClass="nav-button" text="📊 Dashboard" />
                <Button fx:id="btnStudents" onAction="#handleStudents" style="-fx-text-fill: white;" styleClass="nav-button" text="👨‍🎓 Students" />
                <Button fx:id="btnTeachers" onAction="#handleTeachers" style="-fx-background-color: #2F4C7A; -fx-text-fill: white; -fx-font-weight: bold;" styleClass="nav-button" text="👨‍🏫 Teachers" />
                <Button fx:id="btnCourses" onAction="#handleCourses" style="-fx-text-fill: white;" styleClass="nav-button" text="📚 Courses" />
                <Button fx:id="btnGrades" onAction="#handleGrades" style="-fx-text-fill: white;" styleClass="nav-button" text="📝 Grades" />
            <Button onAction="#handleReport" style="-fx-text-fill: white;" styleClass="nav-button" text="📊 Reports" />
            </VBox>
            <VBox VBox.vgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-font-weight: bold;" styleClass="logout-button" text="🚪  Logout" />
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="24" styleClass="main-container">
            
            <!-- Header & Actions -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox>
                    <Label styleClass="page-title" text="👨‍🏫 All Teachers" />
                    <Label styleClass="page-subtitle" text="Manage teaching staff and assignments" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleExportExcel" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" styleClass="btn-outline" text="📊 Excel" />
                
                <!-- ✅ TWO EXPORT BUTTONS -->
                <HBox spacing="10" />
            <Button onAction="#handleExportPDF" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" styleClass="btn-primary" text="📄 PDF" />
                
                <Button onAction="#handleAddTeacher" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" styleClass="btn-primary" text="➕ Add New Teacher" />
            </HBox>

            <!-- Search & Filter Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-section">
                <TextField fx:id="txtSearch" promptText="🔍 Search by name, email, or subject..." style="-fx-padding: 8; -fx-background-radius: 8;" styleClass="form-input" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="cbSubjectFilter" prefWidth="180" promptText="All Subjects" styleClass="form-input" />
                <ComboBox fx:id="cbStatusFilter" prefWidth="130" promptText="All Status" styleClass="form-input" />
                <Button onAction="#handleSearch" style="-fx-background-color: #263F6B; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold; -fx-text-fill: white;" styleClass="btn-primary" text="Search" />
                <Button onAction="#handleClearFilters" style="-fx-background-color: #263F6B; -fx-background-radius: 8; -fx-padding: 8 16; -fx-text-fill: white; -fx-font-weight: bold;" styleClass="btn-outline" text="Clear" />
            </HBox>

            <!-- Teachers Table -->
            <VBox styleClass="form-section" VBox.vgrow="ALWAYS">
                <TableView fx:id="teachersTable" styleClass="custom-table">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="200" text="Full Name" />
                        <TableColumn fx:id="colEmail" prefWidth="220" text="Email" />
                        <TableColumn fx:id="colPhone" prefWidth="140" text="Phone" />
                        <TableColumn fx:id="colSubject" prefWidth="180" text="Subject" />
                        <TableColumn fx:id="colQualification" prefWidth="130" text="Qualification" />
                        <TableColumn fx:id="colStatus" prefWidth="110" text="Status" />
                        <TableColumn fx:id="colActions" prefWidth="120" text="Actions" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Pagination Info -->
            <HBox alignment="CENTER" spacing="12">
                <Label fx:id="lblTeacherCount" styleClass="page-subtitle" text="Showing 0 teachers" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnPrevious" onAction="#handlePrevious" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8;" styleClass="btn-outline" text="⬅ Previous" />
                <Label fx:id="lblPageInfo" style="-fx-font-weight: bold;" text="Page 1 of 1" />
                <Button fx:id="btnNext" onAction="#handleNext" style="-fx-background-color: #263F6B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8;" styleClass="btn-outline" text="Next ➡" />
            </HBox>

        </VBox>
    </center>
</BorderPane>
